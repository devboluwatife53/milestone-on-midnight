{
  "name": "@milestone/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "proof-server": "docker compose -f proof-server.yml up",
    "deploy:preview": "node --no-warnings --loader ts-node/esm src/deploy-preview.ts",
    "post:preview": "node --no-warnings --loader ts-node/esm src/post-preview.ts",
    "reply:preview": "node --no-warnings --loader ts-node/esm src/reply-preview.ts",
    "status:preview": "node --no-warnings --loader ts-node/esm src/join-preview.ts",
    "deploy:preprod": "node --no-warnings --loader ts-node/esm src/deploy-preprod.ts",
    "post:preprod": "node --no-warnings --loader ts-node/esm src/post-preprod.ts",
    "reply:preprod": "node --no-warnings --loader ts-node/esm src/reply-preprod.ts",
    "status:preprod": "node --no-warnings --loader ts-node/esm src/join-preprod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@milestone/contract": "*",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.2.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.3",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

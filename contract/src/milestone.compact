pragma language_version >= 0.20;

import CompactStandardLibrary;

// ======================================================================
// Public ledger state — readable by anyone on chain.
// ======================================================================
export struct MilestonePost {
  id: Uint<64>;
  parentId: Uint<64>; // 0 = top-level post; otherwise the id being replied to
  author: Bytes<32>;
  label: Opaque<"string">;
}

// The public wall: every post and reply ever dropped, newest first.
export ledger feed: List<MilestonePost>;
export ledger postCount: Counter;

constructor() {}

// ======================================================================
// Witness — private, off-chain state never written to the ledger.
// ======================================================================
witness localSecretKey(): Bytes<32>;

// ======================================================================
// Circuits
// ======================================================================

// Drop a new milestone onto the public wall.
export circuit post(label: Opaque<"string">): [] {
  postCount.increment(1);
  const author = publicKey(localSecretKey());
  feed.pushFront(MilestonePost {
    id: postCount,
    parentId: 0,
    author: disclose(author),
    label: disclose(label),
  });
}

// Reply to an existing post (or reply) on the wall.
export circuit reply(parentId: Uint<64>, label: Opaque<"string">): [] {
  assert(parentId > 0, "Invalid parent post");
  assert(parentId <= postCount, "Parent post does not exist");
  postCount.increment(1);
  const author = publicKey(localSecretKey());
  feed.pushFront(MilestonePost {
    id: postCount,
    parentId: disclose(parentId),
    author: disclose(author),
    label: disclose(label),
  });
}

// Derive a stable, pseudonymous author id from the caller's private secret
// key. The chain only ever sees this one-way hash — never the key itself,
// and never the wallet's real address.
export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "milestone:pk:"), sk]);
}

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ======================================================================
// Public ledger state — readable by anyone on chain.
// ======================================================================
export struct MilestonePost {
  author: Bytes<32>;
  tier: Uint<64>;
  label: Opaque<"string">;
}

// The public wall: every celebration post ever disclosed, newest first.
export ledger feed: List<MilestonePost>;
export ledger totalCelebrated: Counter;

constructor() {}

// ======================================================================
// Witnesses — private, off-chain state never written to the ledger.
// ======================================================================
witness localSecretKey(): Bytes<32>;
witness addToHiddenProgress(percent: Uint<64>): Uint<64>;
witness currentTier(): Uint<64>;
witness advanceTier(): [];

// ======================================================================
// Circuits
// ======================================================================

// Anyone can log private percentage progress toward a personal goal —
// money saved, distance run, whatever the caller is privately tracking,
// expressed as a percentage of that goal. The percentage never touches the
// ledger. Only when the caller's cumulative hidden progress crosses their
// next full 100% (one completed goal) do we disclose a public celebration
// post to the shared feed: the tier reached and the label the caller chose
// to share ("got a new car") — never the private percentage behind it.
export circuit celebrate(percent: Uint<64>, label: Opaque<"string">): [] {
  assert(percent > 0, "Percent must be positive");
  assert(percent <= 100, "Percent must be at most 100");
  const milestoneStep: Uint<64> = 100;
  const newTotal = addToHiddenProgress(percent);
  const tier = currentTier();
  const nextThreshold = (tier + 1) * milestoneStep;
  const crossed = disclose(newTotal >= nextThreshold);
  if (crossed) {
    advanceTier();
    const author = publicKey(localSecretKey());
    feed.pushFront(MilestonePost {
      author: disclose(author),
      tier: disclose((tier + 1) as Uint<64>),
      label: disclose(label),
    });
    totalCelebrated.increment(1);
  }
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "milestone:pk:"), sk]);
}
